{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=Atlas;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Database": {
    "Provider": "SqlServer",
    "ApplyMigrationsOnStartup": false
  },
  "Branding": {
    "CompanyName": "Atlas",
    "Tagline": "Web and mobile apps for Saudi businesses.",
    "PrimaryColor": "#1e63e9",
    "ContactEmail": "",
    "LogoUrl": ""
  },
  "Seed": {
    "AdminEmail": "",
    "AdminPassword": ""
  },
  "FileStorage": {
    "RootPath": "App_Data/uploads",
    "RequestPath": "/uploads"
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "DisableHttpsRedirection": false
}
