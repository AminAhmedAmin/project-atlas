@inherits LayoutComponentBase
@implements IDisposable
@inject BrandingService Branding

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (_settings is not null)
{
    <MudLayout Class="public-layout">
        <MudAppBar Elevation="0" Class="public-appbar">
            <MudContainer MaxWidth="MaxWidth.Large" Class="d-flex align-center px-0">
                <BrandLogo Settings="_settings" />
                <MudSpacer />
                <nav class="public-nav d-none d-md-flex" aria-label="Main">
                    @foreach (var link in Links)
                    {
                        <NavLink class="public-nav-link" href="@link.Href" Match="@link.Match">@link.Label</NavLink>
                    }
                    <MudButton Href="/contact" Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" Class="ml-3">
                        Get in touch
                    </MudButton>
                </nav>
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Class="d-md-none" aria-label="Open menu"
                               OnClick="() => _drawerOpen = true" />
            </MudContainer>
        </MudAppBar>

        <MudDrawer @bind-Open="_drawerOpen" Anchor="Anchor.End" Variant="@DrawerVariant.Temporary" Elevation="2">
            <MudDrawerHeader>
                <BrandLogo Settings="_settings" />
            </MudDrawerHeader>
            <MudNavMenu>
                @foreach (var link in Links)
                {
                    <MudNavLink Href="@link.Href" Match="@link.Match" OnClick="() => _drawerOpen = false">@link.Label</MudNavLink>
                }
            </MudNavMenu>
        </MudDrawer>

        <MudMainContent Class="public-main">
            @Body

            <footer class="public-footer">
                <MudContainer MaxWidth="MaxWidth.Large">
                    <div class="footer-grid">
                        <div>
                            <BrandLogo Settings="_settings" />
                            @if (!string.IsNullOrWhiteSpace(_settings.Tagline))
                            {
                                <MudText Typo="Typo.body2" Class="mt-3 text-secondary">@_settings.Tagline</MudText>
                            }
                        </div>
                        <nav class="footer-links" aria-label="Footer">
                            @foreach (var link in Links)
                            {
                                <a href="@link.Href">@link.Label</a>
                            }
                        </nav>
                        @if (!string.IsNullOrWhiteSpace(_settings.ContactEmail))
                        {
                            <div>
                                <MudText Typo="Typo.subtitle2">Contact</MudText>
                                <a href="mailto:@_settings.ContactEmail">@_settings.ContactEmail</a>
                            </div>
                        }
                    </div>
                    <MudDivider Class="my-6" />
                    <div class="d-flex flex-wrap justify-space-between gap-2">
                        <MudText Typo="Typo.caption">&copy; @DateTime.UtcNow.Year @_settings.CompanyName. All rights reserved.</MudText>
                        <a class="footer-admin-link" href="/admin">Admin</a>
                    </div>
                </MudContainer>
            </footer>
        </MudMainContent>
    </MudLayout>
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private static readonly (string Href, string Label, NavLinkMatch Match)[] Links =
    [
        ("/", "Home", NavLinkMatch.All),
        ("/services", "Services", NavLinkMatch.Prefix),
        ("/about", "About", NavLinkMatch.Prefix),
        ("/contact", "Contact", NavLinkMatch.Prefix),
    ];

    private SiteSettingsDto? _settings;
    private MudTheme _theme = new();
    private bool _drawerOpen;

    protected override async Task OnInitializedAsync()
    {
        Apply(await Branding.GetAsync());
        Branding.Changed += OnBrandingChanged;
    }

    private void OnBrandingChanged(SiteSettingsDto settings) => _ = InvokeAsync(() =>
    {
        Apply(settings);
        StateHasChanged();
    });

    private void Apply(SiteSettingsDto settings)
    {
        if (_settings?.PrimaryColor != settings.PrimaryColor)
        {
            _theme = ThemeFactory.Create(settings.PrimaryColor);
        }

        _settings = settings;
    }

    public void Dispose() => Branding.Changed -= OnBrandingChanged;
}
