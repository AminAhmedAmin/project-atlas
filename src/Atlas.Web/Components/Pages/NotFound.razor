@page "/not-found"
@layout PublicLayout

<PageTitle>Page not found</PageTitle>
<HeadContent><meta name="robots" content="noindex" /></HeadContent>

<section class="section">
    <MudContainer MaxWidth="MaxWidth.Small" Class="text-center py-16">
        <MudText Typo="Typo.h2" HtmlTag="h1" Color="Color.Primary">404</MudText>
        <MudText Typo="Typo.h5" Class="mt-2 mb-6">Sorry, we couldn't find that page.</MudText>
        <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" DropShadow="false">Back to home</MudButton>
    </MudContainer>
</section>
