@page "/services"
@inject BrandingService Branding
@inject UseCases UseCases

@if (Settings is not null && Page is not null && Items is not null)
{
    <SeoHead Title="@Render(Page.Title)" Description="@Page.MetaDescription" CompanyName="@Settings.CompanyName" />

    <PageHeader Title="@Render(Page.Title)" Subtitle="@Render(Page.Subtitle)" />

    <section class="section">
        <MudContainer MaxWidth="MaxWidth.Large">
            @if (!string.IsNullOrWhiteSpace(Page.Body))
            {
                <div class="mb-10 prose">
                    @foreach (var paragraph in ContentText.Paragraphs(Page.Body, Settings.CompanyName))
                    {
                        <MudText Typo="Typo.body1" Class="mb-4">@paragraph</MudText>
                    }
                </div>
            }

            @if (Items.Count == 0)
            {
                <MudText Typo="Typo.body1" Class="text-secondary">Our services will be listed here soon.</MudText>
            }
            else
            {
                <div class="card-grid">
                    @foreach (var service in Items)
                    {
                        <ServiceCard Service="service" ShowDescription="true" CompanyName="@Settings.CompanyName" />
                    }
                </div>
            }
        </MudContainer>
    </section>

    @if (!string.IsNullOrWhiteSpace(Page.CallToActionText) && !string.IsNullOrWhiteSpace(Page.CallToActionUrl))
    {
        <section class="cta-band">
            <MudContainer MaxWidth="MaxWidth.Medium" Class="text-center">
                <MudButton Href="@Page.CallToActionUrl" Variant="Variant.Filled" Size="Size.Large" Class="cta-band-button" DropShadow="false">
                    @Page.CallToActionText
                </MudButton>
            </MudContainer>
        </section>
    }
}

@code {
    [PersistentState] public SiteSettingsDto? Settings { get; set; }

    [PersistentState] public PageContentDto? Page { get; set; }

    [PersistentState] public List<ServiceDto>? Items { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Settings ??= await Branding.GetAsync();
        Page ??= await UseCases.QueryAsync<GetPageContentQuery, PageContentDto>(new(PageKey.Services));
        Items ??= (await UseCases.QueryAsync<GetServicesQuery, IReadOnlyList<ServiceDto>>(new(PublishedOnly: true))).ToList();
    }

    private string Render(string? text) => ContentText.Render(text, Settings?.CompanyName ?? string.Empty);
}
