@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>
<HeadContent><meta name="robots" content="noindex" /></HeadContent>

<section class="section">
    <MudContainer MaxWidth="MaxWidth.Small" Class="text-center py-16">
        <MudText Typo="Typo.h4" HtmlTag="h1" Color="Color.Error">Something went wrong</MudText>
        <MudText Typo="Typo.body1" Class="mt-2 mb-6">An error occurred while processing your request. Please try again.</MudText>
        @if (ShowRequestId)
        {
            <MudText Typo="Typo.caption">Request ID: <code>@RequestId</code></MudText>
        }
        <div class="mt-6">
            <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" DropShadow="false">Back to home</MudButton>
        </div>
    </MudContainer>
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
