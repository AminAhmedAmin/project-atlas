@page "/contact"
@page "/ar/contact"
@inherits PublicComponentBase
@using ContactMessageEntity = Atlas.Domain.Contact.ContactMessage
@inject BrandingService Branding
@inject UseCases UseCases

@if (Settings is not null && Page is not null)
{
    <SeoHead Title="@Render(Page.Title)" Description="@Page.MetaDescription" CompanyName="@CompanyNameOf(Settings, Lang)" />

    <PageHeader Title="@Render(Page.Title)" Subtitle="@Render(Page.Subtitle)" />

    <section class="section">
        <MudContainer MaxWidth="MaxWidth.Large">
            <MudGrid Spacing="8">
                <MudItem xs="12" md="7">
                    @if (_sent)
                    {
                        <MudPaper Class="pa-8 text-center" Outlined="true" Elevation="0">
                            <MudIcon Icon="@Icons.Material.Outlined.MarkEmailRead" Color="Color.Success" Style="font-size:3rem" />
                            <MudText Typo="Typo.h5" HtmlTag="h2" Class="mt-4 mb-2">@L("Thank you!")</MudText>
                            <MudText Typo="Typo.body1" Class="mb-6">@L("Your message has been sent. We will get back to you soon.")</MudText>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="Reset">@L("Send another message")</MudButton>
                        </MudPaper>
                    }
                    else
                    {
                        <EditForm Model="_model" OnSubmit="SubmitAsync" FormName="contact">
                            <MudPaper Class="pa-6 pa-md-8" Outlined="true" Elevation="0">
                                <MudGrid Spacing="3">
                                    <MudItem xs="12" sm="6">
                                        <MudTextField @bind-Value="_model.Name" Label="@L("Name")" Variant="Variant.Outlined"
                                                      MaxLength="ContactMessageEntity.NameMaxLength" autocomplete="name"
                                                      Error="@_errors.ContainsKey(NameField)" ErrorText="@_errors.GetValueOrDefault(NameField)" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudTextField @bind-Value="_model.Email" Label="@L("E-mail")" Variant="Variant.Outlined"
                                                      InputType="InputType.Email" autocomplete="email" Class="ltr-input"
                                                      Error="@_errors.ContainsKey(EmailField)" ErrorText="@_errors.GetValueOrDefault(EmailField)" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudTextField @bind-Value="_model.Phone" Label="@L("Phone (optional)")" Variant="Variant.Outlined"
                                                      InputType="InputType.Telephone" autocomplete="tel" Class="ltr-input"
                                                      MaxLength="PhoneNumber.MaxLength"
                                                      Error="@_errors.ContainsKey(PhoneField)" ErrorText="@_errors.GetValueOrDefault(PhoneField)" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudSelect T="string" @bind-Value="_model.Service" Label="@L("Service you're interested in")" Variant="Variant.Outlined" Clearable="true">
                                            @foreach (var service in ServiceOptions)
                                            {
                                                <MudSelectItem T="string" Value="service">@service</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudText Typo="Typo.body2" Class="mb-2 text-secondary">@L("Budget (optional)")</MudText>
                                        <MudChipSet T="string" @bind-SelectedValue="_model.Budget" SelectionMode="SelectionMode.ToggleSelection" CheckMark="true" Variant="Variant.Outlined" Color="Color.Primary">
                                            @foreach (var budget in BudgetRanges.All)
                                            {
                                                <MudChip T="string" Value="budget">@BudgetLabel(budget)</MudChip>
                                            }
                                        </MudChipSet>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudTextField @bind-Value="_model.Subject" Label="@L("Subject (optional)")" Variant="Variant.Outlined"
                                                      MaxLength="ContactMessageEntity.SubjectMaxLength"
                                                      Error="@_errors.ContainsKey(SubjectField)" ErrorText="@_errors.GetValueOrDefault(SubjectField)" />
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudTextField @bind-Value="_model.Message" Label="@L("Message")" Variant="Variant.Outlined"
                                                      Lines="6" Sizing="InputSizing.Auto" MaxLength="ContactMessageEntity.MessageMaxLength" Counter="ContactMessageEntity.MessageMaxLength"
                                                      Error="@_errors.ContainsKey(MessageField)" ErrorText="@_errors.GetValueOrDefault(MessageField)" />
                                    </MudItem>
                                    @* Honeypot: hidden from people, often filled in by bots. *@
                                    <div class="hp-field" aria-hidden="true">
                                        <label for="website">Website</label>
                                        <input id="website" name="website" tabindex="-1" autocomplete="off" @bind="_model.Website" />
                                    </div>
                                    @if (_error is not null)
                                    {
                                        <MudItem xs="12">
                                            <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
                                        </MudItem>
                                    }
                                    <MudItem xs="12">
                                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                                                   Disabled="_submitting" DropShadow="false" EndIcon="@Icons.Material.Filled.Send">
                                            @(_submitting ? L("Sending…") : L("Send message"))
                                        </MudButton>
                                    </MudItem>
                                </MudGrid>
                            </MudPaper>
                        </EditForm>
                    }
                </MudItem>
                <MudItem xs="12" md="5">
                    <div class="contact-aside">
                        @if (!string.IsNullOrWhiteSpace(Page.Body))
                        {
                            @foreach (var paragraph in ContentText.Paragraphs(Page.Body, CompanyNameOf(Settings, Lang)))
                            {
                                <MudText Typo="Typo.body1" Class="mb-4">@paragraph</MudText>
                            }
                        }
                        @if (!string.IsNullOrWhiteSpace(Settings.WhatsAppNumber))
                        {
                            <div class="d-flex align-center gap-3 mt-4">
                                <MudIcon Icon="@Icons.Custom.Brands.WhatsApp" Style="color:#25d366" />
                                <div>
                                    <MudText Typo="Typo.subtitle2">@L("Prefer WhatsApp?")</MudText>
                                    <a href="@($"https://wa.me/{Settings.WhatsAppNumber}?text={Uri.EscapeDataString(L("Hello! I'd like to ask about your services."))}")" target="_blank" rel="noopener">@L("Message us on WhatsApp")</a>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Settings.ContactEmail))
                        {
                            <div class="d-flex align-center gap-3 mt-4">
                                <MudIcon Icon="@Icons.Material.Outlined.Email" Color="Color.Primary" />
                                <div>
                                    <MudText Typo="Typo.subtitle2">@L("Prefer e-mail?")</MudText>
                                    <a href="mailto:@Settings.ContactEmail" dir="ltr">@Settings.ContactEmail</a>
                                </div>
                            </div>
                        }
                        <div class="d-flex align-center gap-3 mt-4">
                            <MudIcon Icon="@Icons.Material.Outlined.Schedule" Color="Color.Primary" />
                            <MudText Typo="Typo.body2">@L("We usually reply within one business day.")</MudText>
                        </div>
                    </div>
                </MudItem>
            </MudGrid>
        </MudContainer>
    </section>
}

@code {
    private const string NameField = nameof(SubmitContactMessageCommand.Name);
    private const string EmailField = nameof(SubmitContactMessageCommand.Email);
    private const string SubjectField = nameof(SubmitContactMessageCommand.Subject);
    private const string MessageField = nameof(SubmitContactMessageCommand.Message);
    private const string PhoneField = nameof(SubmitContactMessageCommand.Phone);
    private static readonly TimeSpan Cooldown = TimeSpan.FromSeconds(20);

    private ContactFormModel _model = new();
    private Dictionary<string, string> _errors = [];
    private bool _sent;
    private bool _submitting;
    private string? _error;
    private DateTime _lastSubmittedUtc = DateTime.MinValue;

    [PersistentState] public SiteSettingsDto? Settings { get; set; }

    [PersistentState] public PageContentDto? Page { get; set; }

    [PersistentState] public List<string>? ServiceTitles { get; set; }

    /// <summary>Preselects a service, e.g. from "Ask about this service" links.</summary>
    [SupplyParameterFromQuery(Name = "service")] public string? ServiceQuery { get; set; }

    private IEnumerable<string> ServiceOptions => (ServiceTitles ?? []).Append(L("Other"));

    protected override async Task OnInitializedAsync()
    {
        Settings ??= await Branding.GetAsync();
        Page ??= await UseCases.QueryAsync<GetPageContentQuery, PageContentDto>(new(PageKey.Contact, Lang));
        ServiceTitles ??= (await UseCases.QueryAsync<GetServicesQuery, IReadOnlyList<ServiceDto>>(new(PublishedOnly: true, Lang)))
            .Select(s => s.Title)
            .ToList();

        if (_model.Service is null && ServiceQuery is { } requested && ServiceOptions.Contains(requested))
        {
            _model.Service = requested;
        }
    }

    private string BudgetLabel(string key) => L(BudgetRanges.Label(key));

    private async Task SubmitAsync()
    {
        _error = null;
        _errors = Validate(_model);
        if (_errors.Count > 0)
        {
            return;
        }

        if (!string.IsNullOrEmpty(_model.Website))
        {
            _sent = true; // Silently drop bot submissions.
            return;
        }

        if (DateTime.UtcNow - _lastSubmittedUtc < Cooldown)
        {
            _error = L("Please wait a few seconds before sending another message.");
            return;
        }

        _submitting = true;
        try
        {
            var result = await UseCases.SendAsync<SubmitContactMessageCommand, Guid>(
                new SubmitContactMessageCommand(
                    _model.Name, _model.Email, _model.Subject, _model.Message,
                    _model.Phone, _model.Service, _model.Budget, Lang));

            if (result.IsSuccess)
            {
                _lastSubmittedUtc = DateTime.UtcNow;
                _sent = true;
            }
            else
            {
                // Server rules mirror the checks above; map any remaining errors to localized messages.
                _errors = result.Errors
                    .Where(e => e.Field is not null)
                    .GroupBy(e => e.Field!)
                    .ToDictionary(g => g.Key, g => MessageFor(g.Key));
                _error = _errors.Count == 0 ? L("Something went wrong. Please try again.") : null;
            }
        }
        finally
        {
            _submitting = false;
        }
    }

    private Dictionary<string, string> Validate(ContactFormModel model)
    {
        var errors = new Dictionary<string, string>();
        if (string.IsNullOrWhiteSpace(model.Name) || model.Name.Trim().Length > ContactMessageEntity.NameMaxLength)
        {
            errors[NameField] = MessageFor(NameField);
        }

        if (!EmailAddress.TryCreate(model.Email, out _))
        {
            errors[EmailField] = MessageFor(EmailField);
        }

        if (!string.IsNullOrWhiteSpace(model.Phone) && !PhoneNumber.IsValid(model.Phone))
        {
            errors[PhoneField] = L("Please enter a valid phone number.");
        }

        if (model.Subject?.Trim().Length > ContactMessageEntity.SubjectMaxLength)
        {
            errors[SubjectField] = L("This text is too long.");
        }

        if (string.IsNullOrWhiteSpace(model.Message) || model.Message.Trim().Length > ContactMessageEntity.MessageMaxLength)
        {
            errors[MessageField] = MessageFor(MessageField);
        }

        return errors;
    }

    private string MessageFor(string field) => field switch
    {
        NameField => L("Please enter your name."),
        EmailField => string.IsNullOrWhiteSpace(_model.Email) ? L("Please enter your e-mail address.") : L("Please enter a valid e-mail address."),
        MessageField => L("Please enter a message."),
        PhoneField => L("Please enter a valid phone number."),
        _ => L("This text is too long."),
    };

    private void Reset()
    {
        _model = new ContactFormModel();
        _errors = [];
        _sent = false;
    }

    private string Render(string? text) => ContentText.Render(text, CompanyNameOf(Settings, Lang));

    private sealed class ContactFormModel
    {
        public string Name { get; set; } = string.Empty;

        public string Email { get; set; } = string.Empty;

        public string? Subject { get; set; }

        public string? Phone { get; set; }

        public string? Service { get; set; }

        public string? Budget { get; set; }

        public string Message { get; set; } = string.Empty;

        public string? Website { get; set; }
    }
}
