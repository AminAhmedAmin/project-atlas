@inherits PublicComponentBase

<PageTitle>@FullTitle</PageTitle>
<HeadContent>
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <meta name="description" content="@Description" />
        <meta property="og:description" content="@Description" />
    }
    <meta property="og:title" content="@FullTitle" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@CompanyName" />
    <meta property="og:url" content="@CanonicalUrl" />
    <meta property="og:locale" content="@(IsArabic ? "ar_SA" : "en_US")" />
    <link rel="canonical" href="@CanonicalUrl" />
    @* Tell search engines about the other language version of this page. *@
    <link rel="alternate" hreflang="en" href="@UrlFor(SiteLanguage.English)" />
    <link rel="alternate" hreflang="ar" href="@UrlFor(SiteLanguage.Arabic)" />
    <link rel="alternate" hreflang="x-default" href="@UrlFor(SiteLanguage.English)" />
</HeadContent>

@code {
    /// <summary>Page-specific title. Omit on the home page to show only the company name and tagline.</summary>
    [Parameter] public string? Title { get; set; }

    [Parameter] public string? Description { get; set; }

    [Parameter, EditorRequired] public string CompanyName { get; set; } = string.Empty;

    [Parameter] public string? Tagline { get; set; }

    private string FullTitle => string.IsNullOrWhiteSpace(Title)
        ? (string.IsNullOrWhiteSpace(Tagline) ? CompanyName : $"{CompanyName} | {Tagline}")
        : $"{Title} | {CompanyName}";

    private string CanonicalUrl => Navigation.Uri.Split('?', '#')[0];

    private string UrlFor(SiteLanguage language)
    {
        var uri = new Uri(Navigation.Uri);
        var path = SiteLanguages.Localize(SiteLanguages.NeutralPath(uri.AbsolutePath), language);
        return $"{uri.Scheme}://{uri.Authority}{path}";
    }
}
