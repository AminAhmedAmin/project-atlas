<div class="section-heading @(Centered ? "text-center mx-auto" : "")">
    @if (!string.IsNullOrWhiteSpace(Eyebrow))
    {
        <MudText Typo="Typo.overline" Color="Color.Primary" Class="section-eyebrow">@Eyebrow</MudText>
    }
    <MudText Typo="Typo.h4" HtmlTag="h2">@Title</MudText>
    @if (!string.IsNullOrWhiteSpace(Lead))
    {
        <MudText Typo="Typo.subtitle1" Class="section-lead mt-3">@Lead</MudText>
    }
</div>

@code {
    [Parameter] public string? Eyebrow { get; set; }

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter] public string? Lead { get; set; }

    [Parameter] public bool Centered { get; set; }
}
