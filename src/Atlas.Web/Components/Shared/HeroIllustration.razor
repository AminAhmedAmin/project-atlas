@* Decorative illustration (web app + mobile app) that follows the brand color via CSS classes. *@
<svg class="hero-illustration" viewBox="0 0 560 460" role="img" aria-label="A web application and a mobile app">
    <circle class="hi-tint" cx="300" cy="230" r="210" />

    @* Browser window *@
    <g filter="url(#hi-shadow)">
        <rect x="24" y="56" width="420" height="290" rx="16" class="hi-surface" />
    </g>
    <rect x="24" y="56" width="420" height="36" rx="16" class="hi-chrome" />
    <rect x="24" y="76" width="420" height="16" class="hi-chrome" />
    <circle cx="46" cy="74" r="5" fill="#ff5f57" />
    <circle cx="62" cy="74" r="5" fill="#febc2e" />
    <circle cx="78" cy="74" r="5" fill="#28c840" />
    <rect x="110" y="66" width="200" height="16" rx="8" class="hi-line" />

    @* Sidebar *@
    <rect x="40" y="108" width="80" height="222" rx="10" class="hi-soft" />
    <rect x="52" y="124" width="56" height="10" rx="5" class="hi-primary" />
    <rect x="52" y="146" width="44" height="8" rx="4" class="hi-line" />
    <rect x="52" y="164" width="50" height="8" rx="4" class="hi-line" />
    <rect x="52" y="182" width="38" height="8" rx="4" class="hi-line" />

    @* KPI cards *@
    <rect x="136" y="108" width="92" height="56" rx="10" class="hi-soft" />
    <rect x="148" y="122" width="40" height="8" rx="4" class="hi-line" />
    <rect x="148" y="138" width="56" height="14" rx="5" class="hi-primary" />
    <rect x="240" y="108" width="92" height="56" rx="10" class="hi-soft" />
    <rect x="252" y="122" width="40" height="8" rx="4" class="hi-line" />
    <rect x="252" y="138" width="48" height="14" rx="5" class="hi-dark" />
    <rect x="344" y="108" width="84" height="56" rx="10" class="hi-soft" />
    <rect x="356" y="122" width="36" height="8" rx="4" class="hi-line" />
    <rect x="356" y="138" width="52" height="14" rx="5" class="hi-primary-soft" />

    @* Chart *@
    <rect x="136" y="176" width="292" height="154" rx="10" class="hi-soft" />
    <rect x="156" y="262" width="22" height="52" rx="5" class="hi-primary-soft" />
    <rect x="190" y="238" width="22" height="76" rx="5" class="hi-primary-soft" />
    <rect x="224" y="250" width="22" height="64" rx="5" class="hi-primary-soft" />
    <rect x="258" y="214" width="22" height="100" rx="5" class="hi-primary" />
    <rect x="292" y="228" width="22" height="86" rx="5" class="hi-primary-soft" />
    <rect x="326" y="200" width="22" height="114" rx="5" class="hi-primary" />
    <rect x="360" y="222" width="22" height="92" rx="5" class="hi-primary-soft" />
    <rect x="152" y="190" width="70" height="10" rx="5" class="hi-line" />

    @* Phone *@
    <g filter="url(#hi-shadow)">
        <rect x="372" y="150" width="164" height="300" rx="28" class="hi-dark" />
    </g>
    <rect x="382" y="160" width="144" height="280" rx="20" class="hi-surface" />
    <rect x="430" y="168" width="48" height="8" rx="4" class="hi-dark" />
    <rect x="394" y="190" width="120" height="64" rx="12" class="hi-primary" />
    <rect x="406" y="204" width="60" height="9" rx="4.5" fill="#ffffff" opacity="0.9" />
    <rect x="406" y="222" width="84" height="7" rx="3.5" fill="#ffffff" opacity="0.6" />
    <rect x="406" y="236" width="44" height="7" rx="3.5" fill="#ffffff" opacity="0.6" />
    @for (var i = 0; i < 3; i++)
    {
        var y = 268 + i * 42;
        <rect x="394" y="@y" width="120" height="34" rx="9" class="hi-soft" />
        <circle cx="411" cy="@(y + 17)" r="9" class="hi-primary-soft" />
        <rect x="428" y="@(y + 9)" width="64" height="7" rx="3.5" class="hi-line" />
        <rect x="428" y="@(y + 20)" width="42" height="6" rx="3" class="hi-line" />
    }
    <rect x="394" y="400" width="120" height="26" rx="13" class="hi-primary" />

    @* Badges *@
    <g filter="url(#hi-shadow)">
        <rect x="0" y="8" width="150" height="40" rx="20" class="hi-surface" />
    </g>
    <circle cx="22" cy="28" r="8" class="hi-primary" />
    <text x="38" y="33" class="hi-text" direction="ltr">English · عربي</text>

    <g filter="url(#hi-shadow)">
        <rect x="40" y="368" width="196" height="40" rx="20" class="hi-surface" />
    </g>
    <circle cx="62" cy="388" r="8" fill="#28c840" />
    <text x="78" y="393" class="hi-text">Web · iOS · Android</text>

    <defs>
        <filter id="hi-shadow" x="-20%" y="-20%" width="140%" height="160%">
            <feDropShadow dx="0" dy="12" stdDeviation="14" flood-color="#0f172a" flood-opacity="0.14" />
        </filter>
    </defs>
</svg>
