@page "/admin/content"

<PageTitle>Pages | Admin</PageTitle>

<AdminPageHeader Title="Pages" Description="Edit the text and SEO description of each public page." />

<MudPaper Outlined="true" Elevation="0">
    <MudTabs Elevation="0" ApplyEffectsToContainer="true" TabPanelsClass="pa-6" KeepPanelsAlive="true">
        @foreach (var key in Enum.GetValues<PageKey>())
        {
            <MudTabPanel Text="@key.ToString()">
                <ContentEditor Key="key" />
            </MudTabPanel>
        }
    </MudTabs>
</MudPaper>
