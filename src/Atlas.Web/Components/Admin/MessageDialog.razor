<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(Message.Subject ?? "Message")</MudText>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-wrap gap-x-6 gap-y-1 mb-4">
            <MudText Typo="Typo.body2"><strong>From:</strong> @Message.Name &lt;<a href="mailto:@Message.Email">@Message.Email</a>&gt;</MudText>
            <MudText Typo="Typo.body2" Class="text-secondary">@Message.ReceivedAtUtc.ToLocalTime().ToString("f", System.Globalization.CultureInfo.CurrentCulture)</MudText>
        </div>
        @if (HasDetails)
        {
            <div class="message-details mb-4">
                @if (Message.Phone is not null)
                {
                    <div><span class="text-secondary">Phone</span>
                        <a href="tel:@Message.Phone" dir="ltr">@Message.Phone</a>
                        · <a href="@WhatsAppHref" target="_blank" rel="noopener">WhatsApp</a>
                    </div>
                }
                @if (Message.Service is not null)
                {
                    <div><span class="text-secondary">Service</span> @Message.Service</div>
                }
                @if (Message.Budget is not null)
                {
                    <div><span class="text-secondary">Budget</span> @BudgetRanges.Label(Message.Budget)</div>
                }
                <div><span class="text-secondary">Language</span> @Message.Language</div>
            </div>
        }
        <MudPaper Outlined="true" Elevation="0" Class="pa-4 message-body" dir="auto">@Message.Message</MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Error" Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Delete" OnClick="@(() => Close(MessageAction.Delete))">Delete</MudButton>
        <MudSpacer />
        <MudButton Variant="Variant.Text" OnClick="@(() => Close(MessageAction.MarkUnread))">Mark as unread</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" StartIcon="@Icons.Material.Outlined.Reply"
                   Href="@ReplyHref">Reply</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter, EditorRequired] public ContactMessageDto Message { get; set; } = default!;

    private bool HasDetails => Message.Phone is not null || Message.Service is not null || Message.Budget is not null || Message.Language != SiteLanguage.English;

    private string WhatsAppHref => $"https://wa.me/{PhoneNumber.ToInternationalDigits(Message.Phone ?? string.Empty)}";

    private string ReplyHref =>
        $"mailto:{Message.Email}?subject={Uri.EscapeDataString("Re: " + (Message.Subject ?? "your message"))}";

    private void Close(MessageAction action) => Dialog.Close(DialogResult.Ok(action));

    public enum MessageAction
    {
        MarkUnread,
        Delete,
    }
}
