@inject UseCases UseCases
@inject ISnackbar Snackbar
@inject BrandingService Branding

@if (_model is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <EditForm Model="_model" OnSubmit="SaveAsync">
        <MudGrid Spacing="3">
            <MudItem xs="12">
                <MudTextField @bind-Value="_model.Title" Label="Title" dir="@SiteLanguages.Direction(Language)" Variant="Variant.Outlined" Required="true"
                              MaxLength="PageContent.TitleMaxLength" Error="_errors.Has(nameof(_model.Title))" ErrorText="@_errors.For(nameof(_model.Title))" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_model.Subtitle" Label="Subtitle" dir="@SiteLanguages.Direction(Language)" Variant="Variant.Outlined" Lines="2" Sizing="InputSizing.Auto"
                              MaxLength="PageContent.SubtitleMaxLength" Error="_errors.Has(nameof(_model.Subtitle))" ErrorText="@_errors.For(nameof(_model.Subtitle))" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_model.Body" Label="Body text" dir="@SiteLanguages.Direction(Language)" Variant="Variant.Outlined" Lines="8" Sizing="InputSizing.Auto"
                              HelperText="Separate paragraphs with a blank line. Use {company} to insert the company name."
                              MaxLength="PageContent.BodyMaxLength" Error="_errors.Has(nameof(_model.Body))" ErrorText="@_errors.For(nameof(_model.Body))" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_model.CallToActionText" Label="Button text" dir="@SiteLanguages.Direction(Language)" Variant="Variant.Outlined"
                              MaxLength="PageContent.CallToActionTextMaxLength" Error="_errors.Has(nameof(_model.CallToActionText))" ErrorText="@_errors.For(nameof(_model.CallToActionText))" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_model.CallToActionUrl" Label="Button link" Variant="Variant.Outlined" Placeholder="/contact"
                              HelperText="@(Language == SiteLanguage.Arabic ? "A site path such as /ar/contact, or a full https:// link." : "A site path such as /contact, or a full https:// link.")"
                              MaxLength="PageContent.CallToActionUrlMaxLength" Error="_errors.Has(nameof(_model.CallToActionUrl))" ErrorText="@_errors.For(nameof(_model.CallToActionUrl))" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_model.MetaDescription" Label="Meta description (SEO)" dir="@SiteLanguages.Direction(Language)" Variant="Variant.Outlined" Lines="2"
                              HelperText="Shown by search engines. Aim for 120–160 characters."
                              MaxLength="PageContent.MetaDescriptionMaxLength" Counter="PageContent.MetaDescriptionMaxLength"
                              Error="_errors.Has(nameof(_model.MetaDescription))" ErrorText="@_errors.For(nameof(_model.MetaDescription))" />
            </MudItem>
            @if (_errors.General is not null)
            {
                <MudItem xs="12"><MudAlert Severity="Severity.Error" Dense="true">@_errors.General</MudAlert></MudItem>
            }
            <MudItem xs="12" Class="d-flex align-center gap-3">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
                           Disabled="_saving" StartIcon="@Icons.Material.Outlined.Save">Save</MudButton>
                <MudButton Href="@PublicPath" Target="_blank" Variant="Variant.Text" EndIcon="@Icons.Material.Outlined.OpenInNew">View page</MudButton>
                @if (_updatedAtUtc is { } updated)
                {
                    <MudText Typo="Typo.caption" Class="text-secondary ml-auto">Last saved @updated.ToLocalTime().ToString("g", System.Globalization.CultureInfo.CurrentCulture)</MudText>
                }
            </MudItem>
        </MudGrid>
    </EditForm>
}

@code {
    private PageModel? _model;
    private DateTime? _updatedAtUtc;
    private readonly FieldErrors _errors = new();
    private bool _saving;

    [Parameter, EditorRequired] public PageKey Key { get; set; }

    [Parameter] public SiteLanguage Language { get; set; } = SiteLanguage.English;

    private string PublicPath => SiteLanguages.Localize(Key == PageKey.Home ? "/" : "/" + Key.ToString().ToLowerInvariant(), Language);

    protected override async Task OnInitializedAsync()
    {
        var page = await UseCases.QueryAsync<GetPageContentQuery, PageContentDto>(new(Key, Language));
        _updatedAtUtc = page.UpdatedAtUtc;
        _model = new PageModel
        {
            Title = page.Title,
            Subtitle = page.Subtitle,
            Body = page.Body,
            CallToActionText = page.CallToActionText,
            CallToActionUrl = page.CallToActionUrl,
            MetaDescription = page.MetaDescription,
        };
    }

    private async Task SaveAsync()
    {
        if (_model is null)
        {
            return;
        }

        _saving = true;
        try
        {
            var result = await UseCases.SendAsync<UpdatePageContentCommand, PageContentDto>(new(
                Key, _model.Title, _model.Subtitle, _model.Body, _model.CallToActionText, _model.CallToActionUrl, _model.MetaDescription, Language));

            _errors.Set(result);
            if (result.IsSuccess)
            {
                _updatedAtUtc = result.Value.UpdatedAtUtc;
                Snackbar.Add($"{Key} page ({Language}) saved.", Severity.Success);
            }
            else
            {
                Snackbar.Add("Please fix the highlighted fields.", Severity.Warning);
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed class PageModel
    {
        public string Title { get; set; } = string.Empty;

        public string? Subtitle { get; set; }

        public string? Body { get; set; }

        public string? CallToActionText { get; set; }

        public string? CallToActionUrl { get; set; }

        public string? MetaDescription { get; set; }
    }
}
